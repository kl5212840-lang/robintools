#!/usr/bin/env bash
# ============================================================
# pre-push — 推送前自动检测，拦截非工程文件和隐私泄露
# 安装: git config core.hooksPath .githooks
# ============================================================
set -euo pipefail

# 强制 C locale — 防止中文文件名导致 grep regex 编码不匹配
export LC_ALL=C

# -------- 颜色 --------
RED='\033[0;31m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
BOLD='\033[1m'

# -------- 配置 --------
# 工程允许的文件路径模式（白名单）
ALLOW_PATTERNS=(
  '^src/'
  '^public/'
  '^\.githooks/'
  '^\.github/'
  '^\.claude/settings\.json$'
  '^\.claude/agents/'
  '^\.claude/commands/'
  '^\.claude/workflows/'
  '^\.claude/hooks/'
  '^scripts/'
  '^assets/'
  '^next\.config\.'
  '^tailwind\.config\.'
  '^postcss\.config\.'
  '^tsconfig\.json$'
  '^package\.json$'
  '^package-lock\.json$'
  '^pnpm-lock\.yaml$'
  '^yarn\.lock$'
  '^\.gitignore$'
  '^\.gitattributes$'
  '^\.env\.example$'
  '^README\.md$'
  '^CLAUDE\.md$'
  '^PROJECT_MANAGER\.md$'
  '^AI_SAFETY_RULES\.md$'
  '^MEMORY_POLICY\.md$'
  '^AI_EXECUTION_STANDARD\.md$'
  '^CONTENT_STANDARD\.md$'
  '^TAG_STANDARD\.md$'
  '^SEO_STANDARD\.md$'
  '^ROADMAP\.md$'
  '^LICENSE$'
  '^\.eslintrc'
  '^\.prettierrc'
  '^\.node-version$'
  '^\.nvmrc$'
  '^components\.json$'
  '^Dockerfile$'
  '^\.dockerignore$'
  '^docker-compose\.'
  '^renovate\.json'
  '^vercel\.json$'
)

# 永远拦截的文件名/路径模式
NEVER_ALLOW=(
  '\.env$'
  '\.env\.'
  'settings\.local\.json$'
  '\.local\.json$'
  '\.local$'
  'credentials\.json$'
  '\.pem$'
  'id_rsa'
  'id_ed25519'
  'known_hosts$'
  '\.npmrc$'
  '\.netrc$'
  'npm-debug\.log'
  'yarn-debug\.log'
  # 拦截 AI 测试废稿和一次性脚本（历史教训：2026-06-08 清理了 24 个此类文件）
  'trash/'
  '_test\.'
  'test\.(png|jpg|jpeg|gif)$'
  'output_.*\.png$'
  '_redo_'
  'check_keys'
)

# 敏感内容正则（扩展正则，兼容所有平台 grep -E）
SENSITIVE_PATTERNS=(
  'ark-[a-z0-9]{8}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{12}'
  'sk-[a-zA-Z0-9]{20,}'
  'AKID[a-zA-Z0-9]{20,}'
  'BEGIN.*PRIVATE KEY'
  'ghp_[A-Za-z0-9]{36,}'
  'gho_[A-Za-z0-9]{36,}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
)

# ============ 主逻辑 ============
VIOLATIONS=0
WARNINGS=0
FILES_CHECKED=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then continue; fi

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    BASE=$(git merge-base main "$local_sha" 2>/dev/null || git merge-base master "$local_sha" 2>/dev/null || echo "")
    if [ -n "$BASE" ]; then RANGE="$BASE..$local_sha"; else RANGE="$local_sha"; fi
  else
    RANGE="$remote_sha..$local_sha"
  fi

  CHANGED=$(git -c core.quotepath=false diff --name-only --diff-filter=ACMR "$RANGE" 2>/dev/null || true)
  if [ -z "$CHANGED" ]; then continue; fi

  echo -e "${CYAN}🔍 检测 push 内容 ($RANGE)...${NC}"

  while IFS= read -r file; do
    [ -z "$file" ] && continue
    FILES_CHECKED=$((FILES_CHECKED + 1))
    FILE_OK=true

    # ---- 第 1 层：绝对拦截 ----
    for pattern in "${NEVER_ALLOW[@]}"; do
      if echo "$file" | grep -qiE "$pattern"; then
        echo -e "  ${RED}⛔ 拦截: $file${NC} — 命中拦截规则 '$pattern'"
        VIOLATIONS=$((VIOLATIONS + 1))
        FILE_OK=false
        continue 2
      fi
    done

    # ---- 第 2 层：检查工程相关性 ----
    ALLOWED=false
    for pattern in "${ALLOW_PATTERNS[@]}"; do
      if echo "$file" | grep -qiE "$pattern"; then
        ALLOWED=true
        break
      fi
    done

    if [ "$ALLOWED" = false ]; then
      echo -e "  ${YELLOW}⚠️  非工程文件: $file${NC}"
      echo -e "     ${YELLOW}→ 该文件不在白名单中"
      WARNINGS=$((WARNINGS + 1))
      FILE_OK=false
    fi

    # ---- 第 3 层：敏感内容扫描（跳过 .githooks/ 自身） ----
    if ! echo "$file" | grep -qiE '^\.githooks/'; then
      DIFF_CONTENT=$(git diff "$RANGE" -- "$file" 2>/dev/null | grep '^\+' | grep -v '^+++' || true)
      if [ -n "$DIFF_CONTENT" ]; then
        for pattern in "${SENSITIVE_PATTERNS[@]}"; do
          MATCH=$(echo "$DIFF_CONTENT" | grep -oEe "$pattern" | head -1 || true)
          if [ -n "$MATCH" ]; then
            echo -e "  ${RED}⛔ 敏感数据泄露: $file${NC}"
            echo -e "     ${RED}→ 发现疑似秘钥: ${MATCH:0:40}...${NC}"
            VIOLATIONS=$((VIOLATIONS + 1))
            FILE_OK=false
            break
          fi
        done
      fi
    fi

    # ---- 第 4 层：内容质量扫描（仅 .tsx 内容文件） ----
    if echo "$file" | grep -qiE '^src/content/.*\.tsx$'; then
      DIFF_CONTENT=$(git diff "$RANGE" -- "$file" 2>/dev/null | grep '^\+' | grep -v '^+++' || true)
      if [ -n "$DIFF_CONTENT" ]; then
        QUALITY_VIOLATIONS=0

        # 4a. 反事实内容："不需要配置"等已知错误断言
        # .{0,60} 限制中间间隔防止跨句误判
        if echo "$DIFF_CONTENT" | grep -qi '不需要.{0,30}配置.*就能\|无需.{0,30}配置.*就能\|不.{0,5}需要.{0,30}配置.*就可' 2>/dev/null; then
          echo -e "  ${RED}⛔ 内容质量: $file${NC}"
          echo -e "     ${RED}→ 检测到疑似错误断言（"不需要配置就能使用"等），请核实事实"
          QUALITY_VIOLATIONS=$((QUALITY_VIOLATIONS + 1))
        fi

        # 4b. 跨平台命令泄漏
        if echo "$DIFF_CONTENT" | grep -qi 'isWin.*brew\|isWin.*Homebrew\|isWin.*dmg' 2>/dev/null; then
          echo -e "  ${RED}⛔ 内容质量: $file${NC}"
          echo -e "     ${RED}→ Windows 分支中出现了 macOS 命令，请检查平台隔离"
          QUALITY_VIOLATIONS=$((QUALITY_VIOLATIONS + 1))
        fi
        if echo "$DIFF_CONTENT" | grep -qi 'isMac.*winget\|isMac.*msix\|isMac.*PowerShell' 2>/dev/null; then
          echo -e "  ${RED}⛔ 内容质量: $file${NC}"
          echo -e "     ${RED}→ macOS 分支中出现了 Windows 命令，请检查平台隔离"
          QUALITY_VIOLATIONS=$((QUALITY_VIOLATIONS + 1))
        fi

        # 4c. 价格/版本号缺少时效性标注（仅警告）
        if echo "$DIFF_CONTENT" | grep -qi '¥\|USD\|美元\|Pro.*\$[0-9]\|v[0-9]\+\.[0-9]\+\.[0-9]' 2>/dev/null; then
          if ! echo "$DIFF_CONTENT" | grep -qi 'FreshnessNote\|验证于\|可能已过时' 2>/dev/null; then
            echo -e "  ${YELLOW}⚠️  内容质量: $file${NC}"
            echo -e "     ${YELLOW}→ 检测到价格/版本号但缺少 <FreshnessNote /> 时效性标注"
          fi
        fi

        if [ "$QUALITY_VIOLATIONS" -gt 0 ]; then
          VIOLATIONS=$((VIOLATIONS + QUALITY_VIOLATIONS))
          FILE_OK=false
        fi

        # 4d. "去 B站搜索" 自毁式引用（站内已有详细内容时不应把用户推走）
        if echo "$DIFF_CONTENT" | grep -qi 'B站.*搜索\|到.*B站.*搜\|去.*B站.*找\|B站.*查找\|B站.*搜索\|B站.*搜' 2>/dev/null; then
          echo -e "  ${YELLOW}⚠️  内容质量: $file${NC}"
          echo -e "     ${YELLOW}→ 检测到「去B站搜索」引导——如站内已有详细内容，建议改为站内链接"
        fi

        # 4e. troubleshoot-cards.ts 与 troubleshoot.tsx 一致性
        if echo "$file" | grep -qiE 'troubleshoot-cards\.ts|troubleshoot\.tsx'; then
          TSX_COUNT=$(grep -ch 'ProblemCard id=' src/content/guides/*/troubleshoot.tsx 2>/dev/null | awk -F: '{s+=$1}END{print s+0}')
          CARD_COUNT=$(grep -c '{ id:' src/content/troubleshoot-cards.ts 2>/dev/null || echo 0)
          if [ "$TSX_COUNT" -ne "$CARD_COUNT" ] 2>/dev/null; then
            echo -e "  ${YELLOW}⚠️  内容质量: $file${NC}"
            echo -e "     ${YELLOW}→ troubleshoot.tsx ProblemCard 数量 ($TSX_COUNT) 与 troubleshot-cards.ts ($CARD_COUNT) 不一致，请同步更新"
          fi
        fi
      fi
    fi

    if [ "$FILE_OK" = true ]; then
      echo -e "  ✅ $file"
    else
      echo ""
    fi

  done <<< "$CHANGED"

done

# ============ 结果 ============
echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}📊 文件: ${BOLD}$FILES_CHECKED${NC}${CYAN}  |  ⛔ 违规: ${BOLD}$VIOLATIONS${NC}${CYAN}  |  ⚠️ 警告: ${BOLD}$WARNINGS${NC}"

if [ "$VIOLATIONS" -gt 0 ]; then
  echo ""
  echo -e "${RED}${BOLD}⛔ PUSH 已阻止 — 检测到敏感数据或拦截文件${NC}"
  echo -e "${RED}请修复上述问题后重新 push。${NC}"
  exit 1
fi

if [ "$WARNINGS" -gt 0 ]; then
  echo ""
  echo -e "${YELLOW}${BOLD}⚠️  检测到非工程文件${NC}"
  echo -e "${YELLOW}如确实不需要，用 git rm --cached 移除后重新 push${NC}"
  exit 1
fi

echo -e "  ✅ 全部通过${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
exit 0
